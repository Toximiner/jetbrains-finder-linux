{
  "name": "jetbrains-finder-linux",
  "displayName": "JetBrains Finder for Linux",
  "description": "Unofficial Linux x64 build of JetBrains Finder: live search results and a code preview.",
  "version": "0.3.66",
  "publisher": "Toximiner",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Toximiner/jetbrains-finder-linux#readme",
  "bugs": {
    "url": "https://github.com/Toximiner/jetbrains-finder-linux/issues"
  },
  "keywords": [
    "find in files",
    "search",
    "jetbrains"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onCommand:jetbrainsFinderLinux.open"
  ],
  "contributes": {
    "commands": [
      {
        "command": "jetbrainsFinderLinux.open",
        "title": "Find in Files",
        "category": "JetBrains Finder Linux"
      }
    ],
    "keybindings": [
      {
        "command": "jetbrainsFinderLinux.open",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "!inDebugRepl"
      },
      {
        "command": "jetbrainsFinderLinux.quickOpen",
        "key": "ctrl+p",
        "mac": "cmd+p",
        "when": "activeWebviewPanelId == jetbrainsFinderLinux"
      },
      {
        "command": "jetbrainsFinderLinux.quickOpen",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == jetbrainsFinderLinux"
      },
      {
        "command": "jetbrainsFinderLinux.commands",
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "when": "activeWebviewPanelId == jetbrainsFinderLinux"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --target linux-x64"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/ripgrep": "^1.18.0",
    "jsonc-parser": "^3.3.1",
    "plist": "^3.1.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  },
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Toximiner/jetbrains-finder-linux.git"
  }
}
