{
  "name": "jetbrains-finder-linux",
  "displayName": "JetBrains Finder",
  "description": "JetBrains-style find and replace with live results and code previews. Linux x64 package.",
  "version": "0.6.0",
  "publisher": "Toximiner",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Toximiner/jetbrains-finder-linux#readme",
  "bugs": {
    "url": "https://github.com/Toximiner/jetbrains-finder-linux/issues"
  },
  "keywords": [
    "find in files",
    "search",
    "jetbrains",
    "replace in files"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onCommand:jetbrainsFinderLinux.open",
    "onCommand:jetbrainsFinderLinux.replace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "jetbrainsFinderLinux.open",
        "title": "Find in Files",
        "category": "JetBrains Finder"
      },
      {
        "command": "jetbrainsFinderLinux.replace",
        "title": "Replace in Files",
        "category": "JetBrains Finder"
      },
      {
        "command": "jetbrainsFinderLinux.openInNewWindow",
        "title": "Find in Files (New Window)",
        "category": "JetBrains Finder"
      }
    ],
    "keybindings": [
      {
        "command": "jetbrainsFinderLinux.open",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "!inDebugRepl"
      },
      {
        "command": "jetbrainsFinderLinux.quickOpen",
        "key": "ctrl+p",
        "mac": "cmd+p",
        "when": "activeWebviewPanelId == jetbrainsFinderLinux"
      },
      {
        "command": "jetbrainsFinderLinux.quickOpen",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == jetbrainsFinderLinux"
      },
      {
        "command": "jetbrainsFinderLinux.commands",
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "when": "activeWebviewPanelId == jetbrainsFinderLinux"
      },
      {
        "command": "jetbrainsFinderLinux.replace",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "!inDebugRepl"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --target linux-x64",
    "check": "node --check src/extension.js && node --check media/main.js && node --check src/replace.js && node --check src/replacementController.js && node --check src/previewEditor.js && node --check media/editor.js && node --check src/editorSyntax.js",
    "build:editor": "esbuild media/editor.js --bundle --minify --outfile=media/editor.bundle.js --platform=browser --target=es2020",
    "vscode:prepublish": "npm run build:editor"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/ripgrep": "^1.18.0",
    "jsonc-parser": "^3.3.1",
    "plist": "^3.1.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@vscode/vsce": "^3.6.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "jsdom": "26.1.0"
  },
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Toximiner/jetbrains-finder-linux.git"
  }
}
